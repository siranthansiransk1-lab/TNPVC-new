  "animationSystem": {
    "primaryLibrary": "GSAP",
    "plugin": "ScrollTrigger",
    "implementationPrinciple": "Make scrolling feel like controlling a carefully directed architectural brand film. The page must remain a real, naturally scrollable website; do not turn it into a forced slideshow or hijack the user's scroll.",

    "scrollFeel": {
      "priority": "Critical",
      "defaultApproach": "Keep native browser scrolling and touch momentum. Bind important visual changes to scroll progress with GSAP ScrollTrigger so the user feels in control of the pace.",
      "smoothness": [
        "Scroll-linked timelines must scrub responsively without noticeable lag behind the user's wheel, trackpad or touch input.",
        "Use scrub: true for direct one-to-one control, or a small numeric scrub such as 0.25–0.5 seconds only when it adds polish without making the animation feel delayed. Test and tune per scene.",
        "Use natural easing for entrance and exit tweens that are not directly scrubbed. Do not add easing to every scroll-linked movement if that makes it feel disconnected from scroll position.",
        "Allow users to scroll up and reverse every scroll-linked transition naturally.",
        "Do not hijack wheel or touch events, lock body scrolling, or force users through a fixed sequence.",
        "Do not globally enable scroll-behavior: smooth as a substitute for real animation choreography.",
        "Do not install a smooth-scroll library by default. If one is already part of the project, integrate it correctly with ScrollTrigger. Only propose Lenis if there is a demonstrated benefit and it can be tested without breaking native input, anchors, accessibility or routing.",
        "If smooth scrolling is integrated, keep ScrollTrigger updated from the scrolling library's scroll event and keep all scroll positions, anchors and cleanup consistent.",
        "The page must still scroll normally and remain usable if GSAP fails to load."
      ]
    },

    "timelineArchitecture": {
      "requirements": [
        "Build one clearly scoped GSAP timeline per major scene or a small number of coordinated timelines where a transition genuinely spans two sections.",
        "Use ScrollTrigger start and end values that are chosen based on the real section layout and tuned by testing, not copied blindly across every section.",
        "Use labels in complex timelines to make the order and overlap of image, text, background and detail reveals easy to maintain.",
        "Let scene transitions overlap slightly so one scene visually hands off to the next; avoid unrelated animations starting and stopping abruptly at section boundaries.",
        "Use scrubbed timelines for scroll-driven storytelling and ordinary triggered timelines for small entrance details where direct scrubbing would feel unnatural.",
        "Ensure animations reverse correctly when scrolling upward.",
        "Avoid creating too many nested ScrollTriggers or timelines for individual words and decorative elements.",
        "Do not animate the entire page at once. Keep each scene's choreography purposeful and readable."
      ],
      "pinningPolicy": {
        "desktop": "Pin only the hero and, if testing proves useful, one substantial manufacturing/process scene. Pinned sections must have a clear visual purpose and a measured duration.",
        "mobile": "Default to normal document flow. Disable or greatly simplify pinning on small touch screens and short viewports where pinned content could feel trapped or consume too much screen space.",
        "rules": [
          "Do not pin every section.",
          "Do not use excessive pin durations or leave a blank-looking gap after a pinned scene.",
          "Set pinSpacing intentionally and verify downstream sections do not jump or overlap incorrectly.",
          "Verify layout and refresh behavior after fonts and images have loaded.",
          "Never pin content that users need to read quickly or interact with while scrolling."
        ]
      }
    },

    "transitionChoreography": {
      "overallDirection": "Transitions must feel like a continuous cinematic camera movement through an architectural editorial film, while the site remains clearly navigable and readable.",
      "rules": [
        "Choose one dominant transition idea per scene: a reveal mask, scale drift, background handoff, layered parallax or typography movement. Do not use every effect at once.",
        "Use clip-path or overflow-hidden masks to reveal images cleanly, with a non-animated fallback state in CSS.",
        "Use subtle cross-section color changes between charcoal and warm ivory to create rhythm without flashing or hard visual cuts.",
        "Allow an outgoing image layer to recede or crop while the next scene's image begins to reveal, only where this looks intentional at real scroll speeds.",
        "Use small overlap between outgoing and incoming text animations; do not make all copy fade out before anything new appears.",
        "Keep transition durations proportional to viewport and scroll distance. Do not make visitors scroll through long empty pinned moments just to finish an animation.",
        "Use consistent easing families and image movement scales across scenes so the page feels art-directed as one system.",
        "Avoid arbitrary flashes, aggressive blur, spinning, rubber-band effects, overlarge zooms and scroll-triggered layout jumps."
      ],
      "sceneHandoffs": [
        "Hero to Interior Solutions: hold the hero long enough to read, subtly push in, then let the warm ivory section enter with a controlled reveal; keep the next section's heading visible at the natural handoff.",
        "Interior Solutions to Manufacturing: transition from clean ivory editorial framing into a darker material-focused scene. Introduce the material image before staggering process labels.",
        "Manufacturing to Leadership: reduce industrial movement, resolve the process labels, then reveal the leadership portraits with a calmer, more human pace.",
        "Leadership to Partner Network: let the portrait sequence finish cleanly and hand off to the brighter network gallery; do not abruptly cut faces or titles mid-animation.",
        "Partner Network to Future Vision: gradually simplify the gallery, expand the final architectural image into a wide cinematic composition, then reveal the brand signature and CTAs.",
        "Final Scene to Footer: keep the final composition visually connected to the existing footer without covering, trapping or replacing it."
      ]
    },

    "sceneMotion": {
      "hero": {
        "trigger": "On page entry and scroll progress",
        "sequence": [
          "Reveal the hero image with a restrained clip-path or mask animation.",
          "Use a subtle image scale shift, for example from approximately 1.04 to 1.0, without a dramatic zoom.",
          "Reveal the headline line by line with short, staggered movement.",
          "Bring in body copy and the scroll indicator after the headline is legible.",
          "If desktop pinning is used, tie the final part of the hero movement to scroll progress and release smoothly into the next section."
        ]
      },
      "interiorSolutions": {
        "sequence": [
          "Reveal the section index and heading first.",
          "Bring images in with staggered mask reveals as they enter the viewport.",
          "Use slight differences in reveal timing and image crop for editorial rhythm, not random motion.",
          "Use small hover transforms only on pointer-capable devices; never hide labels or content until hover."
        ]
      },
      "manufacturing": {
        "sequence": [
          "Reveal the material detail first, followed by the wider production/supply visual layers.",
          "Animate the process labels in a clear left-to-right or story sequence consistent with the layout.",
          "Use subtle parallax depth only on desktop; keep movement minimal on mobile.",
          "If pinned on desktop, keep the timeline short enough to maintain a strong sense of progress and release cleanly into leadership."
        ]
      },
      "leadership": {
        "sequence": [
          "Reveal the section heading before the portraits.",
          "Reveal each authentic portrait with a restrained crop or mask transition.",
          "Bring in each person's real name and verified title after the portrait starts to resolve.",
          "Keep each profile readable long enough; do not make the visitor chase rapidly moving cards.",
          "Use neutral placeholders until authentic portraits are provided. Never use stock faces as real leadership portraits."
        ]
      },
      "partnerNetwork": {
        "sequence": [
          "Bring in network categories and imagery in a measured stagger.",
          "Do not convert all vertical scrolling into horizontal scrolling or trap touch gestures.",
          "A horizontal gallery is permitted only if users can operate it naturally and there is an accessible mobile fallback."
        ]
      },
      "closing": {
        "sequence": [
          "Expand or reveal the final architectural image with a restrained cinematic mask.",
          "Introduce the closing headline with clear reading time.",
          "Reveal the authentic TN-PVC logo and CTAs last, without distracting movement.",
          "Transition into the existing footer without a sudden jump."
        ]
      }
    },

    "technicalRequirements": [
      "Inspect the installed GSAP version and existing animation utilities before coding.",
      "Import and register ScrollTrigger correctly for the project's bundler.",
      "Use gsap.context() with a scoped root, or the existing framework-compatible GSAP hook if already installed.",
      "Revert the animation context and kill associated triggers on component unmount.",
      "Make React StrictMode development remounts safe; no duplicate timelines or ScrollTriggers.",
      "Use stable element refs or scoped selectors rather than broad global selectors that could animate other pages.",
      "Call ScrollTrigger.refresh() at appropriate moments after meaningful layout changes or after image/font layout settles; do not call it on every animation frame.",
      "Use invalidateOnRefresh where dynamic measurements require it, and verify start/end positions after resize or route changes.",
      "Use matchMedia or equivalent responsive GSAP conditions to enable desktop-only pinning/parallax and create simplified mobile timelines.",
      "Avoid animating layout-heavy properties continuously; prioritize transforms and opacity.",
      "Ensure content is visible by default before animation initialization, or provide a fail-safe reveal so a JavaScript error never leaves copy permanently hidden.",
      "Do not use GSAP SplitText unless already available or the license and installation are appropriate. A lightweight accessible line/word wrapper is acceptable.",
      "Do not add a second animation or smooth-scroll library without a verified need."
    ],

    "reducedMotion": {
      "required": true,
      "behavior": "Respect prefers-reduced-motion through both CSS and JavaScript. Disable pinned storytelling, large image zooms, parallax and long scrub sequences where necessary. Present all content in normal flow with only minimal or no entrance animation.",
      "mustRemainUsable": "All text, images, links, leadership information and CTAs must remain visible and accessible when animation is disabled."
    },

    "performance": {
      "principles": [
        "Prefer transform and opacity for continuously animated elements.",
        "Avoid continuous backdrop-filter blur, oversized filters and large stacks of composited layers.",
        "Do not add excessive will-change declarations or leave them enabled on every image.",
        "Lazy-load below-the-fold imagery, prioritize the hero image and reserve image dimensions to avoid layout shift.",
        "Avoid layout recalculation in every scroll callback; let ScrollTrigger manage scroll-driven updates.",
        "Keep animation responsive on mid-range mobile devices, not just high-end desktop hardware.",
        "Do not add Three.js, WebGL or canvas effects without a demonstrated visual benefit and an explicit performance budget."
      ],
      "qualityTarget": "Motion should feel smooth and controlled during real mouse-wheel, trackpad, touch and keyboard scrolling. Validate on actual devices when available; do not claim 60 FPS without measuring it."
    },

    "acceptanceTests": [
      "Scroll slowly and quickly through the page: no visible stutter, jump, blank gap or abrupt section cut.",
      "Scroll down and back up: transitions reverse naturally and do not leave elements stuck hidden.",
      "Use mouse wheel, trackpad, touch drag, Page Down, Page Up, Home, End and anchor links: scrolling remains under the visitor's control.",
      "Refresh the page at the top and at a mid-page scroll position: layout and triggers initialize correctly.",
      "Navigate away from and back to About Us: no duplicate triggers or stale animations remain.",
      "Resize the viewport and rotate a mobile device: pinning, start/end positions and section heights recover correctly.",
      "Test with prefers-reduced-motion enabled and with animations unavailable: all content remains visible and usable.",
      "Check mobile for horizontal overflow, pinned-scroll traps, clipped headings and touch gesture conflicts.",
      "Verify no GSAP console warnings, duplicate trigger IDs, missing target warnings or hydration errors are introduced."
    ]
  },

