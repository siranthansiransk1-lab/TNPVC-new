  "accessibilityAndPerformance": {
    "requirements": [
      "Use semantic section, heading, navigation and link elements.",
      "Maintain a logical heading hierarchy.",
      "Ensure readable contrast over images.",
      "Provide visible keyboard focus states.",
      "Use meaningful alternative text.",
      "Use decorative empty alt text for purely decorative images.",
      "Avoid autoplaying audio.",
      "Do not rely solely on animation to reveal essential content.",
      "Use responsive images and appropriate loading priorities.",
      "Reserve image dimensions to reduce layout shifts.",
      "Avoid unnecessary video or oversized assets.",
      "Verify all images load and have a fallback.",
      "Keep the page usable if JavaScript animations fail.",
