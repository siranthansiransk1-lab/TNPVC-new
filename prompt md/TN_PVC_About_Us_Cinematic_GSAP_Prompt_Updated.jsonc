  "mandatoryWorkflow": {
    "step1": "Inspect the actual repository before changing files.\nIdentify the framework, package manager, routes, navigation,\nshared header and footer, design system, assets, installed\ndependencies and build commands.",

    "step2": "Study the attached screenshot and the live website\nif it is accessible. Treat the screenshot as a visual\nreference, not as an existing implementation.",

    "step3": "Create the About Us page inside the current application.\nFollow the existing routing conventions and reuse shared\ncomponents wherever appropriate.",

    "step4": "Use the exact Cloudinary public URLs provided below.\nBuild reusable image and section components. Do not use\nrandom external image URLs or unrelated placeholder images.",

    "step5": "Implement connected GSAP timelines, responsive\nlayouts, reduced-motion behavior and proper animation cleanup.",

    "step6": "Run the available production build and relevant tests.\nFix implementation errors rather than merely describing them."
  },

  "criticalIntegrationRules": {
    "preserveExistingWebsite": true,
    "preserveHomepage": true,
    "preserveProductsPage": true,
    "preserveServicesPage": true,
    "preserveGalleryPage": true,
    "preserveContactPage": true,
